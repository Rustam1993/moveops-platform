APP_ENV=dev
API_ADDR=:8080
DATABASE_URL=postgres://moveops:moveops@db:5432/moveops?sslmode=disable
PUBLIC_WEB_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=mo_sess
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
CSRF_ENFORCE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INVENTORY_SHARE_TTL_HOURS=336
QUOTE_SHARE_TTL_HOURS=336
SIGN_REQUEST_TTL_HOURS=336
EMAIL_MODE=log
EMAIL_FROM=no-reply@moveops.local
EMAIL_REPLY_TO=no-reply@moveops.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
API_MAX_BODY_MB=2
IMPORT_MAX_FILE_MB=25
IMPORT_MAX_ROWS=5000
API_READ_HEADER_TIMEOUT_SEC=5
API_READ_TIMEOUT_SEC=15
API_WRITE_TIMEOUT_SEC=30
API_IDLE_TIMEOUT_SEC=60
RATE_LIMIT_MAX_IPS=10000
SEED_TENANT_SLUG=local-dev
SEED_TENANT_NAME=Local Dev Tenant
SEED_ADMIN_EMAIL=admin@local.moveops
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=Local Admin
